# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# Google Web Client ID for Authentication
# Used to authenticate with Google Services and Firebase.
GOOGLE_WEB_CLIENT_ID=YOUR_WEB_CLIENT_ID

# GitHub Personal Access Token (PAT) for update checker.
# Without a token, GitHub API allows only 60 unauthenticated requests/hour
# per IP. From a mobile network (NAT), this limit is shared across all
# devices on the same carrier gateway and gets exhausted quickly, causing
# the "Versiyalar topilmadi" error in Settings → Ilova yangilanishlari.
#
# Create a classic PAT at https://github.com/settings/tokens
# Scope needed: `public_repo` (the repository is public, but `public_repo`
# gives read access to public repo metadata + releases).
# Token is stored locally on the device inside BuildConfig; it ships inside
# the APK and is therefore public. Use a **fine-grained PAT** scoped to
# ONLY this repository with `Contents: Read-only` for maximum safety.
GITHUB_API_TOKEN=
